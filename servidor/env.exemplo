# Copie para servidor/.env e preencha. O .env fica fora do git.

# Servidor da opção B do robo-cores3-lite.

# Porta do servidor do robô (a 8765 já está ocupada nesta máquina)
ROBO_PORTA=8770

# O mesmo valor vai em firmware/robo_fala/segredos.h
ROBO_TOKEN=troque-por-um-texto-longo

# inemavox local
INEMAVOX_URL=http://127.0.0.1:8010
WHISPER_DAEMON_URL=http://127.0.0.1:7871
WHISPER_MODELO=large-v3
# Voz residente (servidor/voz_residente.py), sobe sob demanda
VOZ_URL=http://127.0.0.1:7872

# Voz: WAV de referência do Chatterbox (o servidor troca o ~ pela pasta do usuário). Padrão da regra global: rachel
VOZ_REF=~/projetos/timesmkt3/media/voice-refs/rachel.wav

# Modelo do claude -p (pela assinatura). haiku responde mais rápido
CLAUDE_MODELO=haiku

# Quantas trocas anteriores entram em cada pedido
HISTORICO_TURNOS=6

# Foto: quanto tempo (s) a foto de /v1/foto fica guardada esperando a fala
FOTO_VALIDADE=60
